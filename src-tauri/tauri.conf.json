{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ghost",
  "version": "0.1.0",
  "identifier": "com.wynterjones.ghost",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Ghost",
        "width": 1000,
        "height": 660,
        "minWidth": 56,
        "minHeight": 56,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "Developer ID Application: Wynter Jones (7X2UF4FZHC)"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU0QjQ1QUIxRUNGQzY5RApSV1NkeHM4ZXEwVkxCZEkrWDU5UkRFVm5qWFh3Qm9LUlN2bmFleEJRb2xRYUJwNUtQaEtNVmFOTgo=",
      "endpoints": [
        "https://github.com/WynterJones/GhostTerminal/releases/latest/download/latest.json"
      ]
    }
  }
}